# Backend variables. Copy to src/.env when running from src/.
# Alternatively copy backend/.env.example and use --env-file backend/.env.
APP_NAME=PortFlow AI API
APP_ENV=development
API_V1_PREFIX=/api/v1
VERSION=0.1.0
SERVICE_NAME=portflow-api
# Optional local PostgreSQL; substitute your own local credentials.
DATABASE_URL=postgresql+psycopg://portflow:change-me@localhost:5432/portflow
# Allowed frontend origins, logging, and reproducible data seed.
CORS_ORIGINS=["http://localhost:5173"]
LOG_LEVEL=INFO
SYNTHETIC_DATA_SEED=2026
# Frontend variables belong in frontend/.env:
# VITE_API_BASE_URL=http://localhost:8000/api/v1
# See docs/environment-variables.md for descriptions.
